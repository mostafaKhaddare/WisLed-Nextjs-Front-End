# Public app config
NEXT_PUBLIC_BASE_URL=https://wisled.ma
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-render-backend-url.onrender.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_STRAPI_URL=https://your-strapi-url
NEXT_PUBLIC_STRAPI_READ_TOKEN=your_public_read_token
NEXT_PUBLIC_WHATSAPP_PHONE=+212612345678

# Optional payment providers
NEXT_PUBLIC_STRIPE_KEY=your_stripe_publishable_key
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
NEXT_PUBLIC_CDN_SPACE_DOMAIN=your_cdn_domain
NEXT_PUBLIC_SPACE_DOMAIN=your_space_domain
NEXT_PUBLIC_SPACE_ENDPOINT=your_space_endpoint

# Sensitive values should be stored in Vercel project env vars and not committed to Git.
STRAPI_WEBHOOK_REVALIDATION_SECRET=your_strapi_webhook_secret
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL=info@wisled.ma
